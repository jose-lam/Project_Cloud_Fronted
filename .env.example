# Copia este archivo a ".env" y ajusta las URLs según tu despliegue.
# En producción, estas deberían apuntar al AWS API Gateway (HTTPS) que expone
# cada microservicio, no directamente a las VMs privadas.

# MS1 - Catálogo (Categorías, Productos, Inventario) — FastAPI, puerto 8000
VITE_MS1_URL=https://okj8uulv98.execute-api.us-east-1.amazonaws.com/ms1

# MS3 - Carrito de compras — Spring Boot, puerto 8083
VITE_MS3_URL=https://okj8uulv98.execute-api.us-east-1.amazonaws.com
# URL completa de la colección; usada por el cliente MS3 en lugar de VITE_MS3_URL.
VITE_MS3_API_URL=https://okj8uulv98.execute-api.us-east-1.amazonaws.com/api/carritos

# MS5 - Analítica (AWS Athena) — Spring Boot, puerto 8080
VITE_MS5_URL=https://okj8uulv98.execute-api.us-east-1.amazonaws.com

# MS2 - Clientes / Pedidos / Pago
# Este microservicio todavía no está implementado. El front funciona con un
# servicio simulado (src/api/ms2.mock.js) que guarda todo en localStorage.
# Cuando MS2 esté listo, define esta URL y cambia USE_MOCK_MS2 a "false".
VITE_MS2_URL=https://okj8uulv98.execute-api.us-east-1.amazonaws.com
VITE_USE_MOCK_MS2=true
